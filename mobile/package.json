{
  "name": "@proph-bet/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "prebuild": "expo prebuild",
    "prebuild:android": "expo prebuild --platform android --clean",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "build:local:android": "cd android && ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk} ./gradlew assembleRelease",
    "build:local:android:preview": "EXPO_PUBLIC_API_URL=https://test.proph.bet/api/v1 npm run prebuild:android && npm run build:local:android"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@proph-bet/shared": "file:../packages/shared",
    "@react-native-community/slider": "^5.1.1",
    "@react-navigation/native": "^7.1.6",
    "@tanstack/react-query": "^5.80.6",
    "date-fns": "^3.6.0",
    "expo": "~53.0.0",
    "expo-auth-session": "~6.1.3",
    "expo-constants": "~17.1.6",
    "expo-crypto": "~14.1.2",
    "expo-font": "~13.3.1",
    "expo-linear-gradient": "~14.1.5",
    "expo-linking": "~7.1.5",
    "expo-router": "~5.1.0",
    "expo-secure-store": "~14.2.3",
    "expo-splash-screen": "~0.30.8",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~6.0.8",
    "expo-updates": "~0.28.17",
    "expo-web-browser": "~14.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.2",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.10.0",
    "react-native-web": "~0.20.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.0.10",
    "typescript": "~5.8.3"
  },
  "private": true
}
